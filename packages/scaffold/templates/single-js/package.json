{
  "name": "__PROJECT_NAME__",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "prepare": "husky",
    "dev": "cross-env BRANCH=dev dec dev --workspace ./",
    "build": "cross-env BRANCH=prod dec build --workspace ./ --out-dir dist",
    "lint": "npm run lint:es && npm run lint:style",
    "lint:fix": "npm run lint:es -- --fix && npm run lint:style -- --fix",
    "lint:es": "eslint . --color",
    "lint:style": "stylelint '**/*.{css,scss,vue}' --cache --cache-location node_modules/.cache/stylelint/"
  },
  "dependencies": {
    "@deot/helper": "^1.1.23",
    "@deot/http": "^1.1.10",
    "@deot/style": "^1.3.1",
    "@deot/vc": "^1.2.6",
    "@zumer/snapdom": "^2.0.1",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "jspdf": "^3.0.3",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "pinia": "^4.0.2",
    "quill": "^2.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@deot/env": "^1.1.0",
    "@deot/style-unocss": "^1.3.1",
    "cross-env": "^10.1.0",
    "postcss-html": "^1.8.0",
    "unocss": "^66.10.0"
  }
}
