{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@deot/env": ["../../../packages/index/src"],
      "@deot/env-*": ["../../../packages/*/src"],
      "@clients/*": ["clients/*"],
      "@servers/*": ["servers/*"]
    }
  },
  "include": [
    "servers/*",
    "clients/*"
  ],
  "exclude": [
    "node_modules/**/*"
  ]
}
