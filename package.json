{
  "private": true,
  "version": "1.0.0",
  "description": "custom helpers",
  "type": "module",
  "packageManager": "pnpm@latest",
  "scripts": {
    "prepare": "husky",
    "init": "npx pnpm install",
    "init:force": "rm -rf ./node_modules pnpm-lock.yaml ./packages/*/node_modules && npm run init",
    "lint": "eslint . --color",
    "lint:fix": "npm run lint -- --fix",
    "lint:style": "stylelint --fix '**/*.{css,scss}' --cache --cache-location node_modules/.cache/stylelint/",
    "link": "ddc link",
    "docs:dev": "doc dev --workspace .",
    "dev": "npm run test",
    "update": "ddc update",
    "build": "ddc build",
    "test": "ddc test",
    "add": "ddc add",
    "release": "ddc release",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "cli:dev": "tsx ./packages/cli/src/index.ts dev",
    "cli:build": "tsx --tsconfig ./tsconfig.json ./packages/cli/src/index.ts build",
    "scaffold:init": "tsx ./packages/scaffold/scripts/preview.ts init",
    "scaffold:dev": "tsx ./packages/scaffold/scripts/preview.ts dev",
    "scaffold:build": "tsx ./packages/scaffold/scripts/preview.ts build",
    "scaffold:lint": "tsx ./packages/scaffold/scripts/preview.ts lint",
    "scaffold:typecheck": "tsx ./packages/scaffold/scripts/preview.ts typecheck"
  },
  "scripts-info": {
    "init": "首次安装",
    "link": "依赖包关联",
    "add": "创建新包或者给包添加依赖",
    "dev": "开发模式",
    "build": "打包模式",
    "update": "更新 devDependencies 和 dependencies",
    "test": "执行测试, 可选择单个包或全部"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deot/env.git"
  },
  "author": "deot",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/deot/env/issues"
  },
  "homepage": "https://github.com/deot/env#readme",
  "devDependencies": {
    "@deot/dev": "^2.10.0",
    "@deot/docs": "^1.2.7"
  }
}
